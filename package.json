{
  "name": "codex-offline-monitor",
  "productName": "Codex Offline Monitor",
  "version": "0.34.0",
  "description": "A strictly local, offline Electron monitor for Codex JSONL session logs.",
  "main": "src/electron/main.js",
  "scripts": {
    "start": "electron .",
    "widget": "electron .",
    "dev": "electron .",
    "test": "node --test \"tests/**/*.test.js\"",
    "pack": "electron-builder --dir",
    "dist:mac": "electron-builder --mac --arm64 --publish never",
    "dist:mac:x64": "electron-builder --mac --x64 --publish never",
    "dist:win": "electron-builder --win --x64 --publish never",
    "dist:win:dir": "electron-builder --win dir --x64 --publish never",
    "dist:linux": "electron-builder --linux --x64 --publish never",
    "lint": "eslint .",
    "verify": "npm run lint && npm test"
  },
  "build": {
    "appId": "local.codex.offlinemonitor",
    "productName": "Codex Offline Monitor",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/electron/**/*",
      "src/shared/**/*",
      "assets/icon.png",
      "assets/icon-win.png",
      "package.json"
    ],
    "mac": {
      "artifactName": "Codex-Offline-Monitor-${version}-${arch}.${ext}",
      "target": [
        "dmg",
        "zip"
      ],
      "forceCodeSigning": true,
      "category": "public.app-category.developer-tools",
      "icon": "assets/icon.png",
      "extendInfo": {
        "LSUIElement": true
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon-win.png"
    },
    "linux": {
      "artifactName": "Codex-Offline-Monitor-${version}.${ext}",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Development",
      "icon": "assets/icon.png",
      "synopsis": "Offline local Codex usage monitor",
      "description": "Reads Codex JSONL session logs locally without network access."
    },
    "nsis": {
      "artifactName": "Codex-Offline-Monitor-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Codex-Offline-Monitor-${version}.${ext}"
    }
  },
  "keywords": [
    "codex",
    "token-usage",
    "electron",
    "desktop-widget",
    "offline",
    "local-only"
  ],
  "author": "icebrent",
  "license": "MIT",
  "dependencies": {
    "chokidar": "^4.0.3"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@eslint/js": "^10.0.1",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "eslint": "^10.7.0",
    "globals": "^17.7.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
